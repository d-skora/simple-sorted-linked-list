{
  "name": "d-skora/simple-sorted-linked-list",
  "description": "A type-safe sorted linked list for PHP 8.2+, with stable scalar typing, custom sort order, and mutation-safe iteration.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Daniel Skora",
      "role": "Developer"
    }
  ],
  "keywords": [
    "linked-list",
    "sorted",
    "data-structure",
    "collection",
    "type-safe"
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-beberlei-assert": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5",
    "shipmonk/phpstan-rules": "^4.4",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "SimpleSortedLinkedList\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SimpleSortedLinkedList\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text --coverage-clover=coverage.xml --coverage-html=coverage-html",
    "phpstan": "phpstan analyse -c phpstan.neon.dist",
    "phpcs": "phpcs --standard=PSR12 src/ tests/",
    "phpcbf": "phpcbf --standard=PSR12 src/ tests/"
  },
  "minimum-stability": "stable"
}
